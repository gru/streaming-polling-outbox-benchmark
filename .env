# Пароль администратора PostgreSQL (postgres). Требования PRD явно задают
# тестовый пароль `postgres`; для прикладных ролей пароли обязательны через env.
POSTGRES_PASSWORD=postgres

# Пароль REST API Patroni (health-эндпоинты /primary, /health работают без auth).
PATRONI_API_PASSWORD=patroni

# Пароли прикладных ролей (минимальные привилегии, requirements.md раздел 5).
SYS_WRITER_PASSWORD=writer_secret
SYS_APP_PASSWORD=app_secret
SYS_REPLICATION_PASSWORD=replication_secret

# Роль drain'ера outbox-таблицы для arm competing (07-cdc-competing.sql)
SYS_DRAINER_PASSWORD=drainer_secret

# Роль мониторинга для postgres_exporter (этап 6)
SYS_MONITOR_PASSWORD=cf1bd8e0017983b79753390d9a24878c



# прогон с публикацией только-insert: polling на потолке пачки
CDC_POLLING_POLL_BATCH_SIZE=10000

# Kafka — транспорт, не объект измерения: produce не должен лимитировать бенчмарк.
# CDC_KAFKA_LINGER_MS=0 — без искусственной задержки батчинга (linger.ms);
# прикладной чанк публикации = глубине конвейера produce: polling — вся peek-пачка
# (10000 = CDC_POLLING_POLL_BATCH_SIZE) одним Task.WhenAll, streaming — дренирует
# весь канал (2048 = ChannelCapacity) за один flush-set.
# acks=all/idempotence не трогаем: на стенде RF=1/min.isr=1 acks=all = leader-ack.
CDC_KAFKA_LINGER_MS=0
CDC_POLLING_KAFKA_BATCH_SIZE=10000
CDC_STREAMING_KAFKA_BATCH_SIZE=2048

# arm competing: 5 независимых воркеров × LIMIT 2000 (суммарно 10k строк в полёте,
# как потолок пачки polling); kafka-чанк = размеру drain-пачки
CDC_COMPETING_WORKER_COUNT=5
CDC_COMPETING_DRAIN_BATCH_SIZE=2000
CDC_COMPETING_KAFKA_BATCH_SIZE=2000
