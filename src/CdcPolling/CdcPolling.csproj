<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CdcPolling</RootNamespace>
    <AssemblyName>CdcPolling</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Npgsql 8.0.x — та же линия, что у Writer (логика работы с LSN одинаковая). -->
    <PackageReference Include="Npgsql" Version="8.0.9" />
    <!-- Kafka-клиент: Confluent.Kafka 2.3.0 напрямую через общий проект CdcKafka
         (как в streaming-outbox). KafkaFlow 4.2.0 убран (этап 8, deviations 9н):
         стек KafkaFlow+Confluent.Kafka нативно SIGSEGV (exit 139) при полной
         потере Kafka-брокеров после любой продукции — воспроизводимо на
         linux/arm64. acks=all и enable.idempotence=true задаются в
         OutboxProducerConfig (CdcKafka). -->
    <!-- OTel 1.9.0 + Prometheus exporter (pull, /metrics) — как у Writer. -->
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.9.0" />
    <PackageReference Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.9.0-beta.2" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.9.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CdcCommon\CdcCommon.csproj" />
    <ProjectReference Include="..\CdcKafka\CdcKafka.csproj" />
  </ItemGroup>

</Project>
