# Пароль администратора PostgreSQL (postgres). Требования PRD явно задают
# тестовый пароль `postgres`; для прикладных ролей пароли обязательны через env.
POSTGRES_PASSWORD=postgres

# Пароль REST API Patroni (health-эндпоинты /primary, /health работают без auth).
PATRONI_API_PASSWORD=patroni

# Пароли прикладных ролей (минимальные привилегии, requirements.md раздел 5).
SYS_WRITER_PASSWORD=writer_secret
SYS_APP_PASSWORD=app_secret
SYS_REPLICATION_PASSWORD=replication_secret

# Роль мониторинга для postgres_exporter (этап 6): подключается напрямую через
# haproxy:5432 (не через PgBouncer), прав — только pg_monitor (чтение статистики:
# replication lag, logical slot state, WAL retention; без peek/advance/REPLICATION).
SYS_MONITOR_PASSWORD=monitor_secret

# Роль drain'ера outbox-таблицы для arm competing (третий подход): колоночный
# SELECT (id, topic, body, created_at) + DELETE на public.outbox_messages
# (07-cdc-competing.sql); работает в паре с Writer writeMode=insertOnly.
SYS_DRAINER_PASSWORD=drainer_secret

# Writer (этап 3): режим подключения pgbouncer | direct и хост-порт HTTP API
# (8080 на этой машине занят другим Docker-проектом, поэтому 18080).
WRITER_CONNECTION_MODE=pgbouncer
WRITER_HTTP_PORT=18080

# CDC Polling (этап 4, profile polling): режим подключения, хост-порт HTTP и
# размеры пачек. CDC_POLLING_POLL_BATCH_SIZE — сколько logical changes брать
# одним peek (1..10000, потолок зафиксирован в SECURITY DEFINER-функции);
# CDC_POLLING_KAFKA_BATCH_SIZE — прикладной batch публикации в Kafka.
# Смена значения: правка .env + docker compose --profile polling up -d --no-deps cdc-polling.
CDC_POLLING_CONNECTION_MODE=pgbouncer
CDC_POLLING_HTTP_PORT=18081
CDC_POLLING_POLL_BATCH_SIZE=100
CDC_POLLING_KAFKA_BATCH_SIZE=100

# Kafka-транспорт для обоих CDC (produce не должен лимитировать бенчмарк):
# CDC_KAFKA_LINGER_MS — linger.ms продюсера; 0 = без искусственной задержки
# батчинга (батчи собираются естественно при bulk-подаче конвейером ProduceAsync).
# Остальное осознанно не вынесено в env: acks=all — семантика (на стенде RF=1/
# min.isr=1 = leader-ack), enable.idempotence=true — копеечная цена, сжатия нет —
# без налога на CPU продюсера, batch.num.messages при linger=0 не условие ожидания.
CDC_KAFKA_LINGER_MS=0

# CDC Streaming (этап 5, profile streaming): хост-порт HTTP и прикладной batch
# публикации в Kafka = глубина drain-цикла publisher'а (репликация всегда напрямую
# через HAProxy — PgBouncer replication-протокол не проксирует). Профили
# polling/streaming взаимоисключающие: перед запуском cdc-streaming остановить
# cdc-polling (docker compose stop cdc-polling).
# Смена значения: правка .env + docker compose --profile streaming up -d --no-deps cdc-streaming.
CDC_STREAMING_HTTP_PORT=18082
CDC_STREAMING_KAFKA_BATCH_SIZE=100

# CDC Competing (третий подход, profile competing): N независимых воркеров в одном
# сервисе разбирают outbox-таблицу (DELETE … FOR UPDATE SKIP LOCKED … RETURNING в
# транзакции поверх publish — at-least-once). Профили взаимоисключающие.
# CDC_COMPETING_WORKER_COUNT — число воркеров (1..32, каждый держит соединение на
# время drain+publish; упрётся в PgBouncer default_pool_size=20);
# CDC_COMPETING_DRAIN_BATCH_SIZE — LIMIT подзапроса, размер выборки одного воркера
# (1..10000; суммарный параллелизм = воркеры × пачка, по умолчанию 5×2000 = 10k);
# CDC_COMPETING_KAFKA_BATCH_SIZE — прикладной чанк публикации внутри пачки.
# Смена значения: правка .env + docker compose --profile competing up -d --no-deps cdc-competing.
CDC_COMPETING_HTTP_PORT=18084
CDC_COMPETING_WORKER_COUNT=5
CDC_COMPETING_DRAIN_BATCH_SIZE=2000
CDC_COMPETING_KAFKA_BATCH_SIZE=2000

# KafkaValidator (этап 7, requirements.md 15): валидатор доставки в Kafka.
# Хост-порт HTTP API; consumer-группа kafka-validator без сохранения оффсетов
# (каждый старт перематывает topic с начала — полный пересчёт всех прогонов).
KAFKA_VALIDATOR_HTTP_PORT=18083
